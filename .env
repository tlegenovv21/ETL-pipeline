MONGO_PASSWORD=supersecretkey
MONGO_DB=metadata_db

# Airflow (Orchestration)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow