# .env file
# Project settings
PROJECT_NAME=data-engineer-task

# MinIO (S3 Storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecretkey
MINIO_ENDPOINT=minio:9000

# MongoDB (Metadata)
